# 复制为 .env 后填写
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 国内网络默认走 HF 镜像下载 bge-m3；海外可改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com
JWT_SECRET=please-change-this-to-a-long-random-secret-0123456789
# 重排序模型（约 2.2GB，运行时占内存约 2.3GB）。Docker 可用内存低于 6GB 时建议设为 false
RERANK_ENABLED=true
# 扫描件 OCR
OCR_ENABLED=true
# 演示知识库和部门账号，生产环境设为 false
KB_DEMO_SEED=true
