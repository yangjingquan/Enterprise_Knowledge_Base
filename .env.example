# 复制为 .env 后填写（cp .env.example .env && chmod 600 .env）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# ===== 向量与重排（默认使用阿里云百炼，4GB 内存服务器即可运行） =====
# 百炼 API Key：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxx
# dashscope（云端，默认）/ local（本地 bge-m3，需 WITH_LOCAL_MODELS=true 且内存 ≥ 8GB）
EMBEDDING_PROVIDER=dashscope
# text-embedding-v3 或 text-embedding-v4；换模型或维度后要运行一次 python -m app.reindex
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# dashscope（gte-rerank-v2）/ local（bge-reranker-v2-m3，约 2.3GB 内存）/ none
RERANK_PROVIDER=dashscope

# ===== 本地模型（仅 EMBEDDING_PROVIDER=local 或 RERANK_PROVIDER=local 时需要） =====
WITH_LOCAL_MODELS=false
# 国内网络走 HF 镜像下载 bge-m3；海外可改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com
# 本地模型模式请改为 6g 以上
PY_MEM_LIMIT=1g

JWT_SECRET=please-change-this-to-a-long-random-secret-0123456789
# 扫描件 OCR
OCR_ENABLED=true
# 演示知识库和部门账号，生产环境设为 false
KB_DEMO_SEED=true
